# Copy this file to .env (cp .env.example .env) and fill in your values. .env is never committed (.gitignore).

# Flask
SECRET_KEY = "change-me-to-a-long-random-string"
SESSION_COOKIE_NAME = "IRWA_SEARCH_ENGINE"
DEBUG = False
DATA_FILE_PATH = "data/fashion_products_dataset.json"

# RAG: LLM provider, "groq" (default, free key at https://console.groq.com/keys) or "anthropic"
LLM_PROVIDER = "groq"
GROQ_API_KEY = "<YOUR_GROQ_API_KEY>"
GROQ_MODEL = "openai/gpt-oss-20b"   # the template's llama-3.1-8b-instant is no longer offered
# ANTHROPIC_API_KEY = "<YOUR_ANTHROPIC_API_KEY>"
# ANTHROPIC_MODEL = "claude-haiku-4-5"

# Web analytics
# GEOIP_ENABLED = 1                       # country/city of public IPs with ip-api.com (0 = off)
# ANALYTICS_FILE = "data/analytics.json"  # optional: keep the analytics tables in this file between restarts
# TRAIN_WORD2VEC = 0                      # 1 = train word2vec at start-up (else on its first use, ~30 s)
